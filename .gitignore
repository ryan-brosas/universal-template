# Machine-local runtime, experiments and test caches are not template content.
.pi/
/tool-smoke-test/
/devdocs/
.pytest_cache/
/state/
.idea/
skills/omarchy
# Host/vendor-managed runtime skills stay installed locally, never published.
/skills/.system/
# Local helpers stay local except the published fidelity gate and its test.
skills/*/scripts/
knowledge/playbooks/*/scripts/
!/knowledge/playbooks/pencil/scripts/
/knowledge/playbooks/pencil/scripts/*
!/knowledge/playbooks/pencil/scripts/verify-fidelity-manifest.py
!/knowledge/playbooks/pencil/scripts/test-verify-fidelity-manifest.py
*.pyc
__pycache__/
