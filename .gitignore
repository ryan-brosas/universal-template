.pi/
# Root catalog gates must be tracked for CI; other root scripts stay local.
/scripts/*
!/scripts/skill-validator.py
!/scripts/repo-hygiene.py
!/scripts/catalog-quality.py
!/scripts/catalog-integrity.py
!/scripts/dead-code.py
!/scripts/conventional-commit.py
!/scripts/policy-consistency.py
!/scripts/runtime-capabilities.py
!/scripts/resolve-model.py
!/scripts/style-lint.py
!/scripts/foundation-search.py
!/scripts/context-budget-baseline.json
!/scripts/fixtures/
# Generated runtime capability state (machine-local, never committed).
/state/
# Skill-local helper scripts stay out of the catalog repo.
skills/*/scripts/
*.pyc
__pycache__/
skills/omarchy
.idea/
.veda/
