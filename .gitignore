# Machine-local runtime, experiments and test caches are not template content.
.pi/
/tool-smoke-test/
/devdocs/
.pytest_cache/
/state/
.idea/
skills/omarchy
/skills/diagnose-crash
# Generated export bundles are local distribution artifacts.
/_export/
# Host/vendor-managed runtime skills stay installed locally, never published.
/skills/.system/
# Local helpers stay local.
skills/*/scripts/
knowledge/playbooks/*/scripts/
*.pyc
__pycache__/
