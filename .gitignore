.pi/
# Retained publication helpers are tracked; other root scripts stay local.
/scripts/*
!/scripts/pr-metadata.py
!/scripts/repo-hygiene.py
!/scripts/publication_fixtures.py
!/scripts/skill-catalog.py
!/scripts/skill-validator.py
!/scripts/web-reference-manifest.py
# Generated runtime capability state (machine-local, never committed).
/state/
# Skill-local helpers stay local except the published fidelity gate and tests.
skills/*/scripts/
!/skills/pencil/scripts/
/skills/pencil/scripts/*
!/skills/pencil/scripts/verify-fidelity-manifest.py
!/skills/pencil/scripts/test-verify-fidelity-manifest.py
# Host/vendor-managed runtime skills stay installed locally, never published.
/skills/.system/
# Optional machine-local model preferences.
/config/model-profiles.local.yaml
*.pyc
__pycache__/
skills/omarchy
.idea/
.veda/
