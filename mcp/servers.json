{
  "mcpServers": {
    "sourcebot": {
      "type": "remote",
      "url": "http://localhost:3000/api/mcp",
      "lifecycle": "keep-alive"
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@4.0.4"
      ],
      "env": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      },
      "lifecycle": "keep-alive"
    },
    "exa": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "exa-mcp-server@3.4.1"
      ],
      "env": {
        "EXA_API_KEY": "${EXA_API_KEY}"
      },
      "lifecycle": "keep-alive"
    },
    "mcp-steroid": {
      "type": "stdio",
      "command": "devrig",
      "args": [
        "mcp"
      ],
      "lifecycle": "keep-alive"
    },
    "figma-bridge": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@gethopp/figma-mcp-bridge@0.0.21"
      ],
      "lifecycle": "keep-alive"
    },
    "paper": {
      "type": "remote",
      "url": "http://127.0.0.1:29979/mcp",
      "lifecycle": "lazy"
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "lifecycle": "lazy"
    }
  }
}
